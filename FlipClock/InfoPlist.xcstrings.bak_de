    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存你选择分享的时钟图片到相册。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the clock image you choose to share to your photo library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你選擇分享的時鐘圖片儲存到相簿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有用に選んだ時計の画像を写真ライブラリに保存します。"
