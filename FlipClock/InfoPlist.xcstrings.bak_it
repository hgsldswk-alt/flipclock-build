    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存你选择分享的时钟图片到相册。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the clock image you choose to share to your photo library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你選擇分享的時鐘圖片儲存到相簿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有用に選んだ時計の画像を写真ライブラリに保存します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert das Uhrenbild, das du teilen möchtest, in deiner Fotomediathek."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda en tu fototeca la imagen del reloj que eliges compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre dans votre photothèque l’image d’horloge que vous choisissez de partager."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva na sua fototeca a imagem do relógio que você escolher compartilhar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유하려고 고른 시계 이미지를 사진 보관함에 저장해요."
          }
        }
      }
    }
  },
  "version": "1.0"
}
