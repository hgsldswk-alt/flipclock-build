    "透明背景由系统决定是否保留。待机的夜间红色由 iOS 自动处理。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透明背景由系统决定是否保留。待机的夜间红色由 iOS 自动处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS controls whether widget backgrounds are shown. StandBy's night colors are managed by iOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透明背景是否保留由系統決定。待機模式的夜間紅色由 iOS 自動處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットの背景を表示するかどうかはiOSが決めます。スタンバイの夜間の色はiOSが管理します。"
          }
        }
      }
    },
    "通知已关闭，前台仍会提醒。可在系统设置开启通知。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭，前台仍会提醒。可在系统设置开启通知。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Alerts still work while the app is open. Enable notifications in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉，前景仍會提醒。可在系統設定開啟通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフです。アプリを開いている間は通知が鳴ります。「設定」で通知をオンにしてください。"
          }
        }
      }
    },
    "通知提示音最长 30 秒。后台无法单独调整通知音量，也无法保证只震动或跟随静音设置，请结合系统通知设置使用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知提示音最长 30 秒。后台无法单独调整通知音量，也无法保证只震动或跟随静音设置，请结合系统通知设置使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification sounds last up to 30 seconds. Background volume and vibration are controlled by iOS, so app-only volume and vibration preferences apply while the app is open."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知提示音最長 30 秒。背景的通知音量與震動由 iOS 控制，App 內的音量與震動偏好僅適用於前景。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知音は最長30秒です。バックグラウンドでの音量とバイブはiOSが管理するため、アプリ内の音量とバイブの設定はアプリを開いている間に反映されます。"
          }
        }
      }
    },
