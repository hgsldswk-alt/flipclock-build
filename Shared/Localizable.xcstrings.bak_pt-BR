    "与你的表盘同步，锁屏也支持 12 小时制。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与你的表盘同步，锁屏也支持 12 小时制。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your clock face, everywhere. Supports 12-hour time on the Lock Screen too."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與你的錶面同步，鎖定畫面也支援 12 小時制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りの文字盤をどこでも。ロック画面でも12時間表示に対応。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Zifferblatt überall. Auch 12-Stunden-Format auf dem Sperrbildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu esfera en todas partes. También formato de 12 horas en la pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre cadran partout. Format 12 heures aussi sur l’écran verrouillé."
          }
        }
      }
    },
