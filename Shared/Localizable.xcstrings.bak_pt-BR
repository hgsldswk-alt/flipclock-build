    "试用已结束，免费时钟和已有记录可继续使用。原配色已保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用已结束，免费时钟和已有记录可继续使用。原配色已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial has ended. The free clock and your records are still available. Your custom colors are saved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用已結束，免費時鐘與既有紀錄可繼續使用。原配色已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お試し期間が終了しました。無料の時計と記録はそのまま使えます。カスタムした色は保存されています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase ist beendet. Die kostenlose Uhr und deine Aufzeichnungen bleiben verfügbar. Deine eigenen Farben sind gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba ha terminado. El reloj gratis y tus registros siguen disponibles. Tus colores propios están guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai est terminé. L’horloge gratuite et vos données restent disponibles. Vos couleurs perso sont conservées."
          }
        }
      }
    },
    "试用结束后，免费时钟、基础计时与已有记录仍可使用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
