    "12 款表盘、自定义配色与字体、翻页声、整点报时、实时活动与全部小组件。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "12 款表盘、自定义配色与字体、翻页声、整点报时、实时活动与全部小组件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "12 clock faces, custom colors and fonts, flip sounds, hourly chimes, Live Activities, and every widget."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "12 款錶面、自訂配色與字體、翻頁聲、整點報時、即時動態與所有小工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12種類の文字盤、色とフォントのカスタマイズ、めくり音、時報、ライブアクティビティ、すべてのウィジェット。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "12 Zifferblätter, eigene Farben und Schriften, Klappgeräusche, Stundenschlag, Live-Aktivitäten und alle Widgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "12 esferas, colores y fuentes propios, sonido de paletas, campanada cada hora, Actividades en Vivo y todos los widgets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "12 cadrans, couleurs et polices personnalisées, bruit des clapets, carillon horaire, Activités en direct et tous les widgets."
          }
        }
      }
    },
