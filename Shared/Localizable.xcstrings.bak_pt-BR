    "在待机小组件中查看正在进行的番茄钟或倒计时。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在待机小组件中查看正在进行的番茄钟或倒计时。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your active Pomodoro or countdown in StandBy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在待機模式的小工具中查看進行中的番茄鐘或倒數計時。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のポモドーロやカウントダウンをスタンバイで表示します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh deinen laufenden Pomodoro oder Countdown im StandBy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve tu Pomodoro o cuenta atrás activos en Modo Reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez votre Pomodoro ou compte à rebours en cours en mode En veille."
          }
        }
      }
    },
    "在系统设置开启待机显示。充电、锁屏并横放 iPhone，长按待机小组件，添加翻页时钟或专注计时。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置开启待机显示。充电、锁屏并横放 iPhone，长按待机小组件，添加翻页时钟或专注计时。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable StandBy in Settings. Charge and lock your iPhone, then place it on its side. Touch and hold a StandBy widget to add Flip Clock or Focus Timer."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統設定開啟待機模式。將 iPhone 充電、鎖定並橫放，長按待機小工具，加入翻頁時鐘或專注計時。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」でスタンバイをオンにし、iPhoneを充電しながらロックして横向きに置きます。スタンバイのウィジェットを長押しすると、パタパタ時計や集中タイマーを追加できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere StandBy in den Einstellungen. Lade und sperre dein iPhone und leg es auf die Seite. Halte ein StandBy-Widget gedrückt, um Klappuhr oder Fokus-Timer hinzuzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el Modo Reposo en Ajustes. Carga y bloquea el iPhone y ponlo de lado. Mantén pulsado un widget de Modo Reposo para añadir Reloj Flip o Temporizador de enfoque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le mode En veille dans Réglages. Chargez et verrouillez l’iPhone, puis posez-le sur le côté. Maintenez un widget En veille pour ajouter Horloge à clapets ou Minuteur de concentration."
          }
        }
      }
    },
