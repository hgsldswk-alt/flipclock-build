    "透明背景由系统决定是否保留。待机的夜间红色由 iOS 自动处理。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透明背景由系统决定是否保留。待机的夜间红色由 iOS 自动处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS controls whether widget backgrounds are shown. StandBy's night colors are managed by iOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透明背景是否保留由系統決定。待機模式的夜間紅色由 iOS 自動處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットの背景を表示するかどうかはiOSが決めます。スタンバイの夜間の色はiOSが管理します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bestimmt, ob Widget-Hintergründe angezeigt werden. Die Nachtfarben im StandBy verwaltet iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decide si se muestran los fondos de los widgets. Los colores nocturnos del Modo Reposo los gestiona iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS décide si les fonds de widget s’affichent. Les couleurs de nuit du mode En veille sont gérées par iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS decide se os fundos dos widgets aparecem. As cores noturnas do Em Espera são controladas pelo iOS."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 배경 표시 여부는 iOS가 정해요. 스탠바이의 야간 색상도 iOS가 관리해요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decide se mostrare gli sfondi dei widget. I colori notturni di StandBy sono gestiti da iOS."
          }
        }
      }
    },
    "通知已关闭，前台仍会提醒。可在系统设置开启通知。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭，前台仍会提醒。可在系统设置开启通知。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Alerts still work while the app is open. Enable notifications in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉，前景仍會提醒。可在系統設定開啟通知。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフです。アプリを開いている間は通知が鳴ります。「設定」で通知をオンにしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind aus. Signale funktionieren bei geöffneter App. Aktiviere Mitteilungen in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones están desactivadas. Las alertas funcionan con la app abierta. Activa las notificaciones en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Les alertes fonctionnent avec l’app ouverte. Activez les notifications dans Réglages."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Os alertas funcionam com o app aberto. Ative as notificações em Ajustes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있어요. 앱을 열어 둔 동안에는 알림이 울려요. 설정에서 알림을 켜세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche sono disattivate. Gli avvisi funzionano con l’app aperta. Attiva le notifiche in Impostazioni."
          }
        }
      }
    },
    "通知提示音最长 30 秒。后台无法单独调整通知音量，也无法保证只震动或跟随静音设置，请结合系统通知设置使用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知提示音最长 30 秒。后台无法单独调整通知音量，也无法保证只震动或跟随静音设置，请结合系统通知设置使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notification sounds last up to 30 seconds. Background volume and vibration are controlled by iOS, so app-only volume and vibration preferences apply while the app is open."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知提示音最長 30 秒。背景的通知音量與震動由 iOS 控制，App 內的音量與震動偏好僅適用於前景。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知音は最長30秒です。バックグラウンドでの音量とバイブはiOSが管理するため、アプリ内の音量とバイブの設定はアプリを開いている間に反映されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungstöne dauern bis zu 30 Sekunden. Lautstärke und Vibration im Hintergrund steuert iOS, daher gelten die App-Einstellungen nur bei geöffneter App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos de notificación duran hasta 30 segundos. El volumen y la vibración en segundo plano los controla iOS, así que las preferencias de la app solo se aplican con la app abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons de notification durent jusqu’à 30 secondes. Le volume et la vibration en arrière-plan sont gérés par iOS ; les préférences de l’app ne s’appliquent qu’avec l’app ouverte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sons de notificação duram até 30 segundos. Volume e vibração em segundo plano são controlados pelo iOS, então as preferências do app só valem com ele aberto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림음은 최대 30초예요. 백그라운드 음량과 진동은 iOS가 제어하므로 앱의 음량·진동 설정은 앱을 열어 둔 동안에만 적용돼요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoni di notifica durano fino a 30 secondi. Volume e vibrazione in background sono gestiti da iOS, quindi le preferenze dell’app valgono solo con l’app aperta."
          }
        }
      }
    },
