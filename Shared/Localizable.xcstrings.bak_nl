    "长按桌面空白处，选择编辑与添加小组件，搜索翻页时钟，选择小、中或大号。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按桌面空白处，选择编辑与添加小组件，搜索翻页时钟，选择小、中或大号。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold an empty area on the Home Screen, then choose Edit and Add Widget. Search for Flip Clock and select a size."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按主畫面空白處，選擇編輯與加入小工具，搜尋翻頁時鐘，選擇小、中或大型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面の何もない所を長押しし、「編集」→「ウィジェットを追加」を選びます。「パタパタ時計」を検索してサイズを選んでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine leere Stelle auf dem Home-Bildschirm gedrückt, wähle Bearbeiten und Widget hinzufügen. Suche nach Klappuhr und wähle eine Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un espacio vacío de la pantalla de inicio, elige Editar y Añadir widget. Busca Reloj Flip y elige un tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une zone vide de l’écran d’accueil, choisissez Modifier puis Ajouter un widget. Cherchez Horloge à clapets et choisissez une taille."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure uma área vazia da Tela de Início, escolha Editar e Adicionar Widget. Busque Relógio Flip e escolha um tamanho."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면 빈 곳을 길게 누르고 편집 → 위젯 추가를 고르세요. 플립 시계를 검색해 크기를 고르세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta un’area vuota della schermata Home, scegli Modifica e Aggiungi widget. Cerca Orologio Flip e scegli una dimensione."
          }
        }
      }
    },
    "长按锁屏，轻点自定，在小组件区域添加翻页时钟。时间格式跟随 App 设置。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按锁屏，轻点自定，在小组件区域添加翻页时钟。时间格式跟随 App 设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold the Lock Screen, tap Customize, and add Flip Clock in the widget area. Time format follows your app settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長按鎖定畫面，輕點自訂，在小工具區域加入翻頁時鐘。時間格式跟隨 App 設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面を長押しして「カスタマイズ」をタップし、ウィジェット欄に「パタパタ時計」を追加します。時刻の表示はアプリの設定に従います。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte den Sperrbildschirm gedrückt, tippe auf Anpassen und füge Klappuhr im Widget-Bereich hinzu. Das Zeitformat folgt deinen App-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la pantalla bloqueada, toca Personalizar y añade Reloj Flip en la zona de widgets. El formato de hora sigue los ajustes de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez l’écran verrouillé, touchez Personnaliser et ajoutez Horloge à clapets dans la zone des widgets. Le format de l’heure suit les réglages de l’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque e segure a Tela Bloqueada, toque em Personalizar e adicione Relógio Flip na área de widgets. O formato da hora segue os ajustes do app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면을 길게 누르고 사용자화를 탭한 뒤 위젯 영역에 플립 시계를 추가하세요. 시간 형식은 앱 설정을 따라요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta la schermata di blocco, tocca Personalizza e aggiungi Orologio Flip nell’area widget. Il formato ora segue le impostazioni dell’app."
          }
        }
      }
    },
