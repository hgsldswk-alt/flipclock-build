    "试用已结束，免费时钟和已有记录可继续使用。原配色已保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用已结束，免费时钟和已有记录可继续使用。原配色已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your trial has ended. The free clock and your records are still available. Your custom colors are saved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用已結束，免費時鐘與既有紀錄可繼續使用。原配色已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お試し期間が終了しました。無料の時計と記録はそのまま使えます。カスタムした色は保存されています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Testphase ist beendet. Die kostenlose Uhr und deine Aufzeichnungen bleiben verfügbar. Deine eigenen Farben sind gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba ha terminado. El reloj gratis y tus registros siguen disponibles. Tus colores propios están guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai est terminé. L’horloge gratuite et vos données restent disponibles. Vos couleurs perso sont conservées."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu teste terminou. O relógio grátis e seus registros continuam disponíveis. Suas cores personalizadas estão salvas."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 끝났어요. 무료 시계와 기록은 계속 쓸 수 있고 직접 설정한 색상도 저장돼 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova è terminata. L’orologio gratuito e i tuoi dati restano disponibili. I colori personalizzati sono salvati."
          }
        }
      }
    },
    "试用结束后，免费时钟、基础计时与已有记录仍可使用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用结束后，免费时钟、基础计时与已有记录仍可使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After your trial, the free clock, basic timers, and your records remain available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用結束後，免費時鐘、基本計時與既有紀錄仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お試し期間後も、無料の時計、基本のタイマー、記録はそのまま使えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Testphase bleiben die kostenlose Uhr, einfache Timer und deine Aufzeichnungen verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras la prueba, el reloj gratis, los temporizadores básicos y tus registros siguen disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l’essai, l’horloge gratuite, les minuteurs de base et vos données restent disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois do teste, o relógio grátis, os timers básicos e seus registros continuam disponíveis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험 후에도 무료 시계, 기본 타이머, 기록은 계속 쓸 수 있어요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo la prova restano disponibili l’orologio gratuito, i timer base e i tuoi dati."
          }
        }
      }
    },
