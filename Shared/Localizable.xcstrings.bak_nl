    "一次买断，无广告。换手机可用同一 Apple ID 恢复购买。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次买断，无广告。换手机可用同一 Apple ID 恢复购买。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One purchase. No ads. Restore on a new iPhone with the same Apple ID."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次買斷，沒有廣告。更換手機可用同一 Apple ID 回復購買項目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入、広告なし。同じApple IDなら新しいiPhoneでも復元できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf. Keine Werbung. Auf einem neuen iPhone mit derselben Apple-ID wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo pago. Sin anuncios. Restaura en un iPhone nuevo con el mismo Apple ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat. Sans pub. Restaurez sur un nouvel iPhone avec le même identifiant Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra. Sem anúncios. Restaure num iPhone novo com o mesmo ID Apple."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구매. 광고 없음. 같은 Apple ID로 새 iPhone에서 복원."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo acquisto. Niente pubblicità. Ripristina su un nuovo iPhone con lo stesso ID Apple."
          }
        }
      }
    },
