    "数据仅保存在本机，无账号、无广告。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据仅保存在本机，无账号、无广告。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays on this device. No account. No ads."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料僅儲存在本機，無需帳號、沒有廣告。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはこの端末内に保存されます。アカウント不要、広告なし。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten bleiben auf diesem Gerät. Kein Konto. Keine Werbung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se quedan en este dispositivo. Sin cuenta. Sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données restent sur cet appareil. Sans compte. Sans pub."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados ficam neste aparelho. Sem conta. Sem anúncios."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 이 기기에만 저장돼요. 계정 없음. 광고 없음."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati restano su questo dispositivo. Nessun account. Niente pubblicità."
          }
        }
      }
    },
    "数据暂时无法读取，原始数据已保留。请关闭后重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据暂时无法读取，原始数据已保留。请关闭后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read your data. The original data is preserved. Please close the app and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法讀取資料，原始資料已保留。請關閉 App 後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを読み込めませんでした。元のデータは保持されています。アプリを閉じてもう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten konnten nicht gelesen werden. Die Originaldaten bleiben erhalten. Bitte schließe die App und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer tus datos. Los datos originales se conservan. Cierra la app e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire vos données. Les données d’origine sont conservées. Fermez l’app et réessayez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler seus dados. Os dados originais estão preservados. Feche o app e tente de novo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 읽지 못했어요. 원본 데이터는 보존돼요. 앱을 닫고 다시 시도하세요."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i dati. I dati originali sono conservati. Chiudi l’app e riprova."
          }
        }
      }
    },
